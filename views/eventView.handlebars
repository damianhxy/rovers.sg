<div class="container">
    <div class="section">
        <div class="row">
            <div class="col-md-6 col-md-offset-3" data-id="{{info._id}}">
                <div class="page-header text-center">
                    <h2><span class="field-edit" data-type="text" data-name="title">{{info.title}}</span></h2>
                    {{#if user.admin}}
                        <div class="text-center">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-success btn-edit">
                                    <i class="fa fa-edit"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-danger btn-delete" data-name="{{info.title}}" data-time="{{info.time}}" data-id="{{info._id}}">
                                    <i class="fa fa-close"></i> Delete
                                </button>
                            </div> <!-- /.btn-group -->
                        </div>
                    {{/if}}
                </div>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th class="col-md-12" colspan="2">
                                <div class="text-center"><i class="fa fa-info-circle"></i> Event Information</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr {{#unless info.location}}class="field-hidden"{{/unless}}>
                            <td class="col-md-3 text-center">Location</td>
                            <td class="col-md-9">
                                <span class="field-edit" data-type="text" data-name="location">{{info.location}}</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="col-md-3 text-center">Start</td>
                            <td class="col-md-9">
                                <span class="field-edit" data-type="combodate" data-name="start">{{info.startPretty}}</span >
                            </td>
                        </tr>
                        <tr>
                            <td class="col-md-3 text-center">Duration</td>
                            <td class="col-md-9" data-name="duration">
                                {{info.duration}}
                            </td>
                        </tr>
                        <tr>
                            <td class="col-md-3 text-center">End</td>
                            <td class="col-md-9">
                                <span class="field-edit" data-type="combodate" data-name="end">{{info.endPretty}}</span>
                            </td>
                        </tr>
                        <tr {{#unless info.details}}class="field-hidden"{{/unless}}>
                            <td class="col-md-3 text-center">Additional Details</td>
                            <td class="col-md-9">
                                <span class="field-edit" data-type="textarea" data-name="details">{{info.details}}</span>
                            </td>
                        </tr>
                        <tr {{#unless info.link}}class="field-hidden"{{/unless}}>
                            <td class="col-md-3 text-center">Link</td>
                            <td class="col-md-9">
                                <a class="field-edit hidden-xs link" data-type="text" data-name="link" href="{{info.link}}" target="_blank">{{info.link}}</a>
                                <a class="field-edit visible-xs link" data-type="text" data-name="link" href="{{info.link}}" target="_blank">External Link</a>
                            </td>
                        </tr>
                        <!-- x-editable doesn't work with select v4 -->
                        <tr {{#unless info.category}}class="field-hidden"{{/unless}}>
                            <td class="col-md-3 text-center">Categories</td>
                            <td class="col-md-9">
                                {{#each info.category}}
                                    <a href="/activities#{{this}}" class="label label-info">{{this}}</a>
                                {{/each}}
                            </td>
                        </tr>
                    </tbody>
                </table> <!-- /.table -->
                <div class="text-center">
                    <div class="label label-info">
                        <span>Event last modified </span><span data-livestamp="{{info.time}}"></span>
                    </div>
                </div>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
    </div>
    {{#if user.admin}}
    <div class="section">
        <div class="page-header text-center"><h2>Upload Photo(s)</h2></div>
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <form class="form-horizontal" action="/events/{{info._id}}" method="post" accept-charset="UTF-8" enctype="multipart/form-data" autocomplete="off" id="uploadForm">
                    <!-- For Multer -->
                    <input type="hidden" name="id" value="{{info._id}}">
                    <div class="form-group">
                        <span class="col-md-2 control-label">File(s)</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <div class="input-group-addon">Max Size: 5MB</div>
                                <textarea id="uploadName" type="textarea" class="form-control" rows="1" readonly>No File(s) Selected</textarea>
                                <span class="input-group-btn">
                                    <span class="btn btn-info btn-file">
                                        <span>Browse...</span>
                                        <input type="file" name="file" accept="image/*" multiple>
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <div class="col-md-10 col-md-offset-2">
                            <button type="submit" class="btn btn-success"><i class="fa fa-cloud-upload"></i> Upload Photo(s)</button>
                        </div>
                    </div> <!-- /.form-group -->
                </form>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
    </div>
    <div class="section">
        <div class="text-center page-header"><h2>Manage photo(s)</h2></div>
        {{#if info.photos}}
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <form class="form-horizontal" action="/events/{{info._id}}?_method=PUT" method="post" accept-charset="UTF-8" autocomplete="off">
                    <div class="form-group">
                        <span class="col-md-2 control-label">Photo</span>
                        <div class="col-md-10">
                            <select class="form-control" name="name">
                                <option value="del">(Delete Favourite)</option>
                                {{#each info.photos}}
                                <option value="{{this.name}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <div class="col-md-10 col-md-offset-2">
                            <button type="submit" class="btn btn-success"><i class="fa fa-star"></i> Make Favourite</button>
                            <span class="pull-right">
                                Currently: {{#if info.favourite.name}}{{info.favourite.name}}{{else}}(None){{/if}}
                            </span>
                        </div>
                    </div> <!-- /.form-group -->
                </form>
                <table class="table table-striped table-bordered sortable" data-sortable>
                    <thead>
                        <tr>
                            <th class="col-md-4">Name</th>
                            <th class="col-md-3">Preview</th>
                            <th class="col-md-3" data-defaultsort="desc" data-firstsort="asc">Added</th>
                            <th class="col-md-2" data-defaultsort="disabled">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each info.photos}}
                        <tr>
                            <td>{{name}}</td>
                            <td>
                                <a data-toggle="lightbox" data-title="{{name}}" href="{{path}}" class="thumbnail">
                                    <img src="{{path}}" alt="{{name}}">
                                </a>
                            </td>
                            </td>
                            <td data-value="{{time}}" data-livestamp="{{time}}"></td>
                            <td>
                                <button class="btn btn-danger btn-xs btn-delete-photo" data-name="{{name}}" data-time="{{time}}">
                                    <i class="fa fa-times-circle"></i> Delete
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
        {{else}}
        <h4 class="text-center">There are currently no photos</h4>
        {{/if}}
    </div>
    {{else}}
    <div class="section text-center">
        <div class="page-header"><h2>Photo Gallery</h2></div>
        {{#if info.photos}}
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="text-center">
                    <div class="btn-group">
                        <button class="btn btn-info carousel-prev">Prev</button>
                        <button class="btn btn-info carousel-next">Next</button>
                    </div>
                </div>
                <div class="slick">
                    {{#each info.photos}}
                    <div>
                        <a data-toggle="lightbox" href="{{path}}" data-title="{{name}}" class="thumbnail">
                            <img alt="{{name}}" title="Click to view larger image" src="{{path}}">
                        </a>
                        <h3>{{name}}</h3>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div> <!-- /.row -->
        {{else}}
        <h4>There are currently no photos</h4>
        {{/if}}
    </div>
    {{/if}}
</div>
<script src="/js/custom/eventView.js"></script>
