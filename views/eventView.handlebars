<div class="col-md-6 col-md-offset-3" data-id="{{info._id}}">
    <div class="page-header text-center">
        <h2><a class="field-edit" data-type="text" data-name="title" href="#">{{info.title}}</a></h2>
        {{#if user.admin}}
            <div class="text-center">
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-success btn-edit">
                        <i class="fa fa-edit"> Edit</i>
                    </button>
                    <a href="#deleteModal" class="btn btn-sm btn-danger" data-toggle="modal" data-title="{{info.title}}" data-time="{{info.time}}">
                        <i class="fa fa-close"> Delete</i>
                    </a>
                </div> <!-- /.btn-group -->
            </div>
        {{/if}}
    </div>
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th class="col-md-12" colspan="2">
                    <div class="text-center"><i class="fa fa-info-circle"></i> Event Information</div>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr {{#unless info.location}}class="field-hidden"{{/unless}}>
                <td class="col-md-3 text-center">Location</td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="text" data-name="location" href="#">{{info.location}}</a>
                </td>
            </tr>
            <tr>
                <td class="col-md-3 text-center">Start</td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="combodate" data-name="start" href="#">{{info.start}}</a>
                </td>
            </tr>
            <tr>
                <td class="col-md-3 text-center">End</td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="combodate" data-name="end" href="#">{{info.end}}</a>
                </td>
            </tr>
            <tr {{#unless info.details}}class="field-hidden"{{/unless}}>
                <td class="col-md-3 text-center">Additional Details</td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="textarea" data-name="details" href="#">{{info.details}}</a>
                </td>
            </tr>
            <tr {{#unless info.link}}class="field-hidden"{{/unless}}>
                <td class="col-md-3 text-center">Link</td>
                <td class="col-md-9">
                    <a class="field-edit hidden-xs link" data-type="text" data-name="link" href="{{info.link}}">{{info.link}}</a>
                    <span class="text-muted visible-xs">Link hidden (space constraints)</span>
                </td>
            </tr>
        </tbody>
    </table> <!-- /.table -->
    {{#if user.admin}}
    <!-- deleteModal -->
    <div id="deleteModal" class="modal fade" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times"></i>
                    </button>
                    <h4 class="modal-title">Delete Event</h4>
                </div>
                <div class="modal-body">
                    <p id="modalEventName"></p>
                    <p id="modalEventTime"></p>
                    <p>Are you sure? This event will be <strong>permanently</strong> deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger">Delete Event</button>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
    <div class="text-center">
        <div class="label label-info">
            <span>Event last modified </span><span data-livestamp="{{info.time}}"></span>
        </div>
    </div>
</div> <!-- /.col-md-6 -->
<script src="/lib/custom/eventView.js"></script>
