<div class="section container">
    <div class="row">
        <div class="col-md-6">
            <div class="page-header">
                <h2>Add an event</h2>
            </div>
            <form id="eventForm" class="form-horizontal" action="/events" method="post" accept-charset="UTF-8" autocomplete="off">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <div class="form-group">
                    <span class="col-md-2 control-label">Name</span>
                    <div class="col-md-10">
                        <div class="input-group">
                            <input type="text" class="form-control" name="title" required>
                            <div class="input-group-addon">*</div>
                        </div>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Location</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="location">
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Start</span>
                    <div class="col-md-10">
                        <div class="input-group">
                            <input type="datetime-local" class="form-control" name="start" required>
                            <div class="input-group-addon">*</div>
                        </div>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Duration</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="duration" disabled>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">End</span>
                    <div class="col-md-10">
                        <div class="input-group">
                            <input type="datetime-local" class="form-control" name="end" required>
                            <div class="input-group-addon">*</div>
                        </div>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Additional Details</span>
                    <div class="col-md-10">
                        <textarea class="form-control" name="details" rows="3"></textarea>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Link</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="link">
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label checkbox-label">Categories</span>
                    <div class="col-md-10">
                        <label class="checkbox-inline"><input type="checkbox" name="category" value="service"> Service</label>
                        <label class="checkbox-inline"><input type="checkbox" name="category" value="fellowship"> Fellowship</label>
                        <label class="checkbox-inline"><input type="checkbox" name="category" value="adventure"> Adventure</label>
                        <label class="checkbox-inline"><input type="checkbox" name="category" value="courses"> Courses</label>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <div class="col-md-10 col-md-offset-2">
                        <button type="submit" class="btn btn-success"><i class="fa fa-plus-circle"></i> Create Event</button>
                    </div> <!-- /.col-md-10 -->
                </div> <!-- /.form-group -->
            </form>
        </div> <!-- /.col-md-6 -->
        <div class="col-md-6">
            <div class="page-header">
                <h2>Preview</h2>
            </div>
            <div id="calendar"></div>
        </div> <!-- /.col-md-6 -->
    </div> <!-- /.row -->
</div>
<script src="/js/custom/eventAdd.js"></script>
