<div class="col-md-6">
    <div class="page-header">
        <span class="h1">Add an event</span>
    </div>
    <form class="form-horizontal" action="/events/add" method="post" accept-charset="UTF-8" role="form">
        <div class="form-group">
            <span class="col-md-2 control-label">Event Name</span>
            <div class="col-md-10">
                <input name="title" class="form-control" type="text" required>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Location</span>
            <div class="col-md-10">
                <input name="location" class="form-control" type="text" placeholder="Optional">
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Start</span>
            <div class="col-md-10">
                <input name="start" class="form-control" data-format="DD/MM/YYYY hh:mm A" data-template="DD / MM / YYYY     hh : mm A" type="text" required>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">End</span>
            <div class="col-md-10">
                <input name="end" class="form-control" data-format="DD/MM/YYYY hh:mm A" data-template="DD / MM / YYYY     hh : mm A" type="text" required>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Details</span>
            <div class="col-md-10">
                <textarea name="details" class="form-control noresize" rows="3" placeholder="Optional"></textarea>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Link</span>
            <div class="col-md-10">
                <input name="link" type="text" class="form-control" placeholder="Optional">
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Actions</span>
            <div class="col-md-10">
                <div class="btn-group" role="group">
                    <button type="submit" class="btn btn-success">Add Event</button>
                    <button id="clear" type="reset" class="btn btn-danger">Clear</button>
                </div> <!-- /.btn-group -->
            </div> <!-- /.col-md-10 -->
        </div> <!-- /.form-group -->
    </form>
</div> <!-- /.col-md-6 -->
<div class="col-md-6">
    <div class="page-header" id="calendar"></div>
</div>