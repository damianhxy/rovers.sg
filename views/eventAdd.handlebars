<div class="col-md-6">
    <div class="page-header">
        <h2>Add an event</h2>
    </div>
    <form id="eventForm" class="form-horizontal" action="/events" method="post" accept-charset="UTF-8" autocomplete="off">
        <div class="form-group">
            <span class="col-md-2 control-label">Name</span>
            <div class="col-md-10">
                <input type="text" class="form-control" name="title" required>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Location</span>
            <div class="col-md-10">
                <input type="text" class="form-control" name="location" placeholder="Optional">
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Start</span>
            <div class="col-md-10">
                <input type="text" name="start" data-format="DD MMMM YYYY hh:mm A" data-template="D / MMMM / YYYY   hh : mm A" required>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">End</span>
            <div class="col-md-10">
                <input type="text" name="end" data-format="DD MMMM YYYY hh:mm A" data-template="D / MMMM / YYYY   hh : mm A" required>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Additional Details</span>
            <div class="col-md-10">
                <textarea class="form-control" name="details" rows="3" placeholder="Optional"></textarea>
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <span class="col-md-2 control-label">Link</span>
            <div class="col-md-10">
                <input type="text" class="form-control" name="link" placeholder="Optional">
            </div>
        </div> <!-- /.form-group -->
        <div class="form-group">
            <div class="col-md-10 col-md-offset-2">
                <button type="submit" class="btn btn-success col-md-4">Create Event</button>
            </div> <!-- /.col-md-10 -->
        </div> <!-- /.form-group -->
    </form>
</div> <!-- /.col-md-6 -->
<div class="col-md-6">
    <div class="page-header" id="calendar"></div>
</div>
<script src="/lib/custom/eventAdd.js"></script>
