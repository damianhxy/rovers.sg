<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <title>{{title}} | Rovers.sg</title>
    <link rel="author" href="/humans.txt">
    <link rel="icon" href="/favicon.ico?v=2">
    <link rel="stylesheet" href="/css/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/css/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/ekko-lightbox.min.css">
    <link rel="stylesheet" href="/css/pnotify.custom.min.css">
    <link rel="stylesheet" href="/css/bootstrap-sortable.css">
    <link rel="stylesheet" href="/js/x-editable/css/bootstrap-editable.css">
    <link rel="stylesheet" href="/css/slick/slick.css">
    <link rel="stylesheet" href="/css/slick/slick-theme.css">
    <link rel="stylesheet" href="/css/fullcalendar.min.css">
    <link rel="stylesheet" href="/css/select2/select2.min.css">
    <link rel="stylesheet" href="/css/select2/select2-bootstrap.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <script src="/js/jquery-3.0.0.min.js"></script>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-default navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
            </div>
            <div id="navbar" class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li><a href="/"><i class="fa fa-home"></i> Home</a></li>
                    <li><a href="/upcoming"><i class="fa fa-calendar"></i> Upcoming</a></li>
                    <li><a href="/activities"><i class="fa fa-bicycle"></i> Activities</a></li>
                    <li><a href="/rjourney"><i class="fa fa-map"></i> Rover Journey</a></li>
                    <li><a href="/join"><i class="fa fa-users"></i> Join Us</a></li>
                    <li><a href="/contact"><i class="fa fa-phone-square"></i> Contact Us</a></li>
                    <li><a href="/resources"><i class="fa fa-archive"></i> Resources</a></li>
                    <li class="dropdown">
                        <a class="dropdown-toggle" href="#" data-toggle="dropdown">
                            <i class="fa fa-info-circle"></i> Information
                            <i class="caret"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="/about"><i class="fa fa-institution"></i> About</a></li>
                            <li><a href="/faq"><i class="fa fa-question-circle"></i> FAQ</a></li>
                        </ul>
                    </li>
                    <li class="dropdown">
                        <a class="dropdown-toggle" href="#" data-toggle="dropdown">
                            <i class="fa fa-external-link"></i> Links
                            <i class="caret"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="http://www.moot.rovers.sg/" target="_blank"><i class="fa fa-globe"></i> Moot</a></li>
                            <li><a href="http://forum.rovers.sg/" target="_blank"><i class="fa fa-comments"></i> Forum</a></li>
                            <li><a href="http://intranet.scout.org.sg/" target="_blank"><i class="fa fa-dashboard"></i> Scout Membership Portal</a></li>
                        </ul>
                    </li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                {{#if user}}
                    <li><a href="/users/profile"><i class="fa fa-user"></i> {{user.username}}</a></li>
                    <li><a href="/users/signout"><i class="fa fa-sign-out"></i> Sign Out</a></li>
                {{else}}
                    <li class="dropdown">
                        <a class="dropdown-toggle" href="#" data-toggle="dropdown">
                            <i class="fa fa-sign-in"></i> Sign In
                            <i class="caret"></i>
                        </a>
                        <div class="dropdown-menu">
                            <form action="/users/signin" method="post" accept-charset="UTF-8" autocomplete="off">
                                <div class="form-group">
                                    <input name="username" class="form-control" type="text" placeholder="Username" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <input name="password" class="form-control" type="password" placeholder="Password" required>
                                </div> <!-- /.form-group -->
                                <button type="submit" class="form-control btn btn-primary">Sign in</button>
                            </form>
                        </div>
                    </li>
                    {{!--
                    <!-- For development purposes -->
                    <li class="dropdown">
                        <a class="dropdown-toggle" href="#" data-toggle="dropdown">
                            <i class="fa fa-user-plus"></i> Sign Up
                            <i class="caret"></i>
                        </a>
                        <div class="dropdown-menu">
                            <form action="/users/signup" method="post" accept-charset="UTF-8">
                                <div class="form-group">
                                    <input id="name" name="name" class="form-control" type="text" placeholder="Name" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <input id="username" name="username" class="form-control" type="text" placeholder="Username" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <input id="password" name="password" class="form-control" type="password" placeholder="Password" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <button type="submit" class="form-control btn btn-primary">Sign Up</button>
                                </div> <!-- /.form-group -->
                            </form>
                        </div>
                    </li>
                    --}}
                {{/if}}
                </ul> <!-- /.navbar-right -->
            </div> <!-- /.navbar-collapse -->
        </div> <!-- /.container -->
    </nav> <!-- /.navbar -->
    <!-- /NAVBAR -->
    {{{body}}}
    <!-- PAGE FOOTER -->
    <footer class="footer">
        <p class="footer__title">
            <a href="/">rovers.sg</a>
        </p>
        <p class="footer__image">
            <img src="/img/Logo.png" alt="Logo">
        </p>
        <p class="footer__links">
            <a href="https://www.facebook.com/singaporeroverscouts/"><i class="fa fa-facebook-square fa-2x"></i></a> •
            <a href="https://twitter.com/SGRoverScouts"><i class="fa fa-twitter-square fa-2x"></i></a> •
            <a href="https://www.instagram.com/sgrovers/"><i class="fa fa-instagram fa-2x"></i></a>
        </p>
        <p class="footer__copyright">
            <small>
                &copy; 2015 ~ 2016
            </small>
        </p>
    </footer> <!-- /footer -->
    <!-- /PAGE FOOTER -->
    <!-- SCRIPTS -->
    <script src="/css/bootstrap/bootstrap.min.js"></script>
    <script src="/js/ekko-lightbox.min.js"></script>
    <script src="/js/moment.min.js"></script>
    <script src="/js/fullcalendar.min.js"></script>
    <script src="/js/x-editable/js/bootstrap-editable.min.js"></script>
    <script src="/js/combodate.js"></script>
    <script src="/js/pnotify.custom.min.js"></script>
    <script src="/js/bootstrap-sortable.js"></script>
    <script src="/js/livestamp.min.js"></script>
    <script src="/css/slick/slick.min.js"></script>
    <script src="/js/select2.min.js"></script>
    <script src="/js/bootbox.min.js"></script>
    <script src="/js/custom/main.js"></script>
    <script>
        $(function() {
            {{#if success}}
            new PNotify({
                title: "{{success}}",
                type: "success"
            });
            {{/if}}
            {{#if error}}
            new PNotify({
                title: "{{error}}",
                type: "error"
            });
            {{/if}}
        });
    </script>
    <!-- /SCRIPTS -->
</body>
