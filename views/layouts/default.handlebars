<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <title>{{title}} | Rovers.sg</title>
    <link rel="author" href="/humans.txt">
    <link rel="icon" href="/favicon.ico?v=1">
    <link rel="stylesheet" href="/css/pace/minimal.css">
    <script src="/css/pace/pace.min.js"></script>
    <link rel="stylesheet" href="/css/bootstrap/css/bootstrap-theme.min.css">
    <link rel="stylesheet" href="/css/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/lightbox/ekko-lightbox.min.css">
    <link rel="stylesheet" href="/css/pnotify/pnotify.custom.min.css">
    <link rel="stylesheet" href="/lib/sortable/bootstrap-sortable.css">
    <link rel="stylesheet" href="/lib/x-editable/css/bootstrap-editable.css">
    <link rel="stylesheet" href="/css/slick/slick.css">
    <link rel="stylesheet" href="/css/slick/slick-theme.css">
    <link rel="stylesheet" href="/css/fullcalendar/fullcalendar.min.css">
    <link rel="stylesheet" href="/css/fullcalendar/fullcalendar.print.css" media="print">
    <link rel="stylesheet" href="/css/main.css">
    <script src="/lib/jquery-2.1.4.min.js"></script>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-default navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="/">
                    <img src="/img/logo.png" alt="logo" height="24">
                </a>
            </div>
            <div id="navbar" class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li><a href="/about"><i class="fa fa-info-circle"></i> About</a></li>
                    <li><a href="/events"><i class="fa fa-calendar"></i> Events</a></li>
                    <li><a href="/resources"><i class="fa fa-archive"></i> Resources</a></li>
                    <li><a href="/faq"><i class="fa fa-question-circle"></i> FAQ</a></li>
                    <li><a href="/contact"><i class="fa fa-phone-square"></i> Contact</a></li>
                    <li><a href="http://www.moot.rovers.sg/"><i class="fa fa-globe"></i> Moot</a></li>
                    <li><a href="http://forum.rovers.sg/"><i class="fa fa-comments"></i> Forum</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                {{#if user}}
                    <li><a href="/users/profile"><i class="fa fa-user"></i> {{user.username}}</a></li>
                    <li><a href="/users/signout"><i class="fa fa-sign-out"></i> Sign Out</a></li>
                {{else}}
                    <li class="dropdown">
                        <a class="dropdown-toggle" href="#" data-toggle="dropdown">
                            <i class="fa fa-sign-in"></i> Sign In
                            <span class="caret"></span>
                        </a>
                        <div class="dropdown-menu">
                            <form action="/users/signin" method="post" accept-charset="UTF-8" autocomplete="off">
                                <div class="form-group">
                                    <input name="username" class="form-control" type="text" placeholder="Username" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <input name="password" class="form-control" type="password" placeholder="Password" required>
                                </div> <!-- /.form-group -->
                                <button type="submit" class="form-control btn btn-primary">Login</button>
                            </form>
                        </div>
                    </li>
                    {{!--
                    <!-- For development purposes -->
                    <li class="dropdown">
                        <a class="dropdown-toggle" href="#" data-toggle="dropdown">
                            <i class="fa fa-user-plus"></i> Sign Up
                            <span class="caret"></span>
                        </a>
                        <div class="dropdown-menu">
                            <form action="/users/signup" method="post" accept-charset="UTF-8">
                                <div class="form-group">
                                    <input id="name" name="name" class="form-control" type="text" placeholder="Name" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <input id="username" name="username" class="form-control" type="text" placeholder="Username" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <input id="password" name="password" class="form-control" type="password" placeholder="Password" required>
                                </div> <!-- /.form-group -->
                                <div class="form-group">
                                    <button type="submit" class="form-control btn btn-primary">Sign Up</button>
                                </div> <!-- /.form-group -->
                            </form>
                        </div>
                    </li>
                    --}}
                {{/if}}
                </ul> <!-- /.navbar-right -->
            </div> <!-- /.navbar-collapse -->
        </div> <!-- /.container-fluid -->
    </nav> <!-- /.navbar -->
    <!-- /NAVBAR -->
    <div class="container-fluid">
        <!-- BANNERS -->
        <div class="row">
            <div class="col-md-6">
                <a data-toggle="lightbox" href="/img/Banner1.jpg" data-title="Great Ocean Trail">
                    <img alt="Great Ocean Trail" class="center-block constrain" title="Click to enlarge image" src="/img/cropped/Banner1.jpg">
                </a>
            </div> <!-- /.col-md-6 -->
            <div class="col-md-6">
                <a data-toggle="lightbox" href="/img/Banner2.jpg" data-title="National Day Commemoration">
                    <img alt="National Day Commemoration" class="center-block constrain" title="Click to enlarge image" src="/img/cropped/Banner2.jpg">
                </a>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
        <!-- /BANNERS -->
        <!-- PAGE CONTENT -->
        <main class="row">
{{{body}}}
        </main>
        <!-- /PAGE CONTENT -->
    </div> <!-- /.container-fluid -->
    <!-- PAGE FOOTER -->
    <footer class="footer">
        <p class="footer__title">
            <a href="/">rovers.sg</a>
        </p>
        <p class="footer__links">
            <small>
                &copy; 2016 &bull;
                <a href="/sitemap"><i class="fa fa-sitemap"></i> Sitemap</a>
            </small>
        </p>
    </footer> <!-- /footer -->
    <!-- /PAGE FOOTER -->
    <!-- SCRIPTS -->
    <script src="/css/bootstrap/js/bootstrap.min.js"></script>
    <script src="/css/lightbox/ekko-lightbox.min.js"></script>
    <script src="/lib/moment.min.js"></script>
    <script src="/css/fullcalendar/fullcalendar.min.js"></script>
    <script src="/lib/x-editable/js/bootstrap-editable.min.js"></script>
    <script src="/lib/combodate.js"></script>
    <script src="/css/pnotify/pnotify.custom.min.js"></script>
    <script src="/lib/sortable/bootstrap-sortable.js"></script>
    <script src="/lib/livestamp.min.js"></script>
    <script src="/css/slick/slick.min.js"></script>
    <script src="/lib/custom/main.js"></script>
    <script>
        $(document).ready(function() {
            {{#if success}}
            new PNotify({
                title: "Success",
                text: "{{success}}",
                type: "success"
            });
            {{/if}}
            {{#if error}}
            new PNotify({
                title: "Error",
                text: "{{error}}",
                type: "error"
            });
            {{/if}}
            $("#calendar").fullCalendar({
                customButtons: {
                    addEvent: {
                        text: "Add Event",
                        click: function() {
                            location.assign("/events/add");
                        }
                    }
                },
                header: {
                    left: "prev,next today",
                    center: "title",
                    {{#if user.admin}}
                    right: "addEvent month,agendaWeek,agendaDay"
                    {{else}}
                    right: "month,agendaWeek,agendaDay"
                    {{/if}}
                }{{#if events}},
                events: {{{events}}}
                {{/if}}
            });
        });
    </script>
    <!-- /SCRIPTS -->
</body>
