<div class="panel panel-default card">
    {{#if favourite.name}}
    <a data-toggle="lightbox" data-title="{{favourite.name}}" href="{{favourite.path}}" class="thumbnail">
        <img src="{{favourite.path}}" alt="{{favourite.name}}">
    </a>
    {{else}}
    <a data-toggle="lightbox" data-title="No Image Available" href="/img/EventPicture.png" class="thumbnail">
        <img src="/img/EventPicture.png" alt="No Image Available">
    </a>
    {{/if}}
    <div class="panel-body">
        <strong class="wrap">{{title}}</strong>
        <p>{{startPretty}}</p>
        <p>({{duration}})</p>
    </div>
    <div class="panel-footer">
        <a href="/upcoming#{{_id}}">View Information</a>
    </div>
</div>
