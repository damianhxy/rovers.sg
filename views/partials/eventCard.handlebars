<div class="panel panel-default card">
    <div class="panel-heading">
        <h3 class="panel-title"><strong class="wrap">{{title}}</strong></h3>
    </div>
    <div class="date">
        <span class="month">{{date.month}}</span>
        <span class="day">{{date.day}}</span>
    </div>
    {{#if favourite.name}}
    <a data-title="Event Image" href="/events#{{_id}}">
        <img src="{{favourite.path}}" alt="{{favourite.name}}">
    </a>
    {{else}}
    <a data-title="No Image Available" href="/events#{{_id}}">
        <img src="/img/EventPicture.png" alt="No Image Available">
    </a>
    {{/if}}
    <table class="table">
        <tr>
            {{#unless category}}<td class="danger"><strong>uncategorised</strong></td>{{/unless}}
            {{#each category}}
            <td class="info"><strong><a href="/events/category/{{this}}">{{this}}</a></strong></td>
            {{/each}}
        </td></tr>
    </table>
</div>
