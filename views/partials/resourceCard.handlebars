<div class="panel panel-primary card">
    <div class="panel-heading">
        <h3 class="panel-title"><strong class="wrap"><i class="fa fa-{{fileType url filename}}"></i> <a class="field-edit link" data-type="text" data-pk="{{_id}}" data-name="name" data-url="/resources" href="{{url}}" target="_blank">{{name}}</a></strong></h3>
    </div>
    <div class="panel-body">
        <p><span class="field-edit wrap" data-type="textarea" data-pk="{{_id}}" data-name="description" data-url="/resources">{{description}}</span></p>
    </div>
    <div class="panel-footer">
        <div class="btn-group">
            <a href="{{url}}" class="btn btn-primary btn-xs" target="_blank">
                <i class="fa fa-cloud"></i> Go To Resource
            </a>
        </div>
    </div>
    <div class="panel-footer">
        <small>Last modified <span data-livestamp="{{time}}"></span></small>
    </div>
</div>