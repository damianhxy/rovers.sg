<div class="col-md-8 col-md-offset-2" data-id="{{info._id}}">
    <div class="page-header text-center">
        <span class="h1"><a class="field-edit" data-type="text" data-name="title">{{info.title}}</a></span>
    </div>
    <table class="table table-striped table-bordered sortable">
        <thead>
            <tr>
                <td class="col-md-12" colspan="2">
                    <div class="text-center">Event Information <i class="fa fa-info-circle"></i></div>
                </td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="col-md-3 text-center">Location <i class="fa fa-map-marker"></i></td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="text" data-name="location">{{info.location}}</a>
                </td>
            </tr>
            <tr>
                <td class="col-md-3 text-center">Starting Time <i class="fa fa-hourglass-start"></i></td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="combodate" data-name="start">{{info.start}}</a>
                </td>
            </tr>
            <tr>
                <td class="col-md-3 text-center">Ending Time <i class="fa fa-hourglass-end"></i></td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="combodate" data-name="end">{{info.end}}</a>
                </td>
            </tr>
            <tr>
                <td class="col-md-3 text-center">Additional Details <i class="fa fa-asterisk"></i></td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="textarea" data-name="details">{{info.details}}</a>
                </td>
            </tr>
            <tr>
                <td class="col-md-3 text-center"><a href="{{info.link}}" target="_blank">External Link <i class="fa fa-external-link"></i></a></td>
                <td class="col-md-9">
                    <a class="field-edit" data-type="text" data-name="link">{{info.link}}</a>
                </td>
            </tr>
        </tbody>
    </table> <!-- /.table -->
    {{#if user.admin}}
    <div class="text-center">
        <div class="btn-group">
            <a href="/events/add" class="btn btn-primary">
                <i class="fa fa-plus"> New</i>
            </a>
            <button type="button" class="btn btn-success btn-edit">
                <i class="fa fa-edit"> Edit</i>
            </button>
            <a href="#deleteModal" class="btn btn-danger btn" data-toggle="modal" data-title="{{info.title}}" data-time="{{info.time}}">
                <i class="fa fa-close"> Delete</i>
            </a>
        </div> <!-- /.btn-group -->
    </div>
    <!-- deleteModal -->
    <div id="deleteModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times"></i>
                    </button>
                    <h4 class="modal-title">Delete Event</h4>
                </div>
                <div class="modal-body">
                    <p id="modalEventName"></p>
                    <p id="modalEventTime"></p>
                    <p>Are you sure? This event will be <strong>permanently</strong> deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
    <div class="text-center">
        <div class="label label-info">
            <span>Event created by <strong>{{info.creator}}</strong> </span><span data-livestamp="{{info.time}}"></span>
        </div>
    </div>
</div> <!-- /.col-md-8 -->