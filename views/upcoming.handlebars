<div class="section text-center container-fluid">
    <div class="page-header"><h2>Upcoming</h2></div>
    {{#unless upcoming}}
    <h3>There are currently no upcoming events</h3>
    {{else}}
    <div class="row">
        {{#each upcoming}}
        <div class="panel panel-info card">
            <div class="panel-heading">
                <h3 class="panel-title">{{title}}</h3>
            </div>
            <a data-toggle="lightbox" data-title="Placeholder" href="/img/EventPicture.png" class="thumbnail">
                <img src="/img/EventPicture.png" alt="Placeholder" class="constrain">
            </a>
            <div class="panel-body">
                <small>From</small>
                <p>{{start}}</p>
                <small>To</small>
                <p>{{end}}</p>
            </div>
            <div class="panel-footer">
                <a href="#{{this._id}}">View Information</a>
            </div>
        </div>
        {{/each}}
    </div>
    {{/unless}}
    <div class="btn-group">
        {{#if user.admin}}
        <a href="/events/add" class="btn btn-success"><i class="fa fa-plus"></i> Create Event</a>
        {{/if}}
        <a href="/events" class="btn btn-info"><i class="fa fa-history"></i> All Events</a>
    </div>
</div>
{{#each upcoming}}
<a class="anchor" id="{{_id}}"></a>
<div class="section text-center container-fluid">
    <div class="page-header">
        <a href="/events/{{_id}}"><h2>{{title}}</h2></a>
    </div>
    <div class="row">
        <div class="col-md-3">
            <a data-toggle="lightbox" data-title="Placeholder" href="/img/EventPicture.png" class="thumbnail">
                <img src="/img/EventPicture.png" alt="Placeholder" class="constrain">
            </a>
        </div> <!-- /.col-md-3 -->
        <div class="col-md-9">
            <dl class="dl-horizontal">
                {{#if location}}
                <dt>Location</dt>
                <dd>{{location}}</dd>
                {{/if}}
                <dt>Start</dt>
                <dd>{{start}}</dd>
                <dt>End</dt>
                <dd>{{end}}</dd>
                {{#if details}}
                <dt>Additional Details</dt>
                <dd>{{details}}</dd>
                {{/if}}
                {{#if link}}
                <dt>Link</dt>
                <dd><a href="{{link}}">{{link}}</a></dd>
                {{/if}}
                <dt>Categories</dt>
                {{#if category}}
                <dd>
                {{#each category}}
                    <a href="/activities/{{this}}" class="label label-info">{{this}}</a>
                {{/each}}
                </dd>
                {{else}}
                <dd>(None)</dd>
                {{/if}}
                <dt>Last Modified</dt>
                <dd data-livestamp="{{time}}"></dd>
            </dl>
        </div> <!-- /.col-md-9 -->
    </div> <!-- /.row -->
</div>
{{/each}}
