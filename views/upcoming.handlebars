<div class="container">
    <div class="section text-center">
        <div class="page-header"><h2>Upcoming Events</h2></div>
        {{> eventCardList upcoming}}
        <div class="btn-group">
            {{#if user.admin}}
            <a href="/events/add" class="btn btn-success"><i class="fa fa-plus"></i> Create Event</a>
            {{/if}}
            <a href="/events" class="btn btn-info"><i class="fa fa-history"></i> All Events</a>
        </div>
    </div>
    {{#each upcoming}}
    <a class="anchor" id="{{_id}}"></a>
    <div class="section text-center">
        <div class="page-header">
            <a href="/events/{{_id}}"><h2>{{title}}</h2></a>
        </div>
        <div class="row">
            <div class="col-md-3">
                {{#if favourite.name}}
                <a data-toggle="lightbox" data-title="{{favourite.name}}" href="{{favourite.path}}" class="thumbnail">
                    <img src="{{favourite.path}}" alt="{{favourite.name}}">
                </a>
                {{else}}
                <a data-toggle="lightbox" data-title="Placeholder" href="/img/EventPicture.png" class="thumbnail">
                    <img src="/img/EventPicture.png" alt="Placeholder">
                </a>
                {{/if}}
            </div> <!-- /.col-md-3 -->
            <div class="col-md-9">
                <dl class="dl-horizontal">
                    {{#if location}}
                    <dt>Location</dt>
                    <dd>{{location}}</dd>
                    {{/if}}
                    <dt>Start</dt>
                    <dd>{{startPretty}}</dd>
                    <dt>Duration</dt>
                    <dd>{{duration}}</dd>
                    {{#if details}}
                    <dt>Additional Details</dt>
                    <dd><pre>{{details}}</pre></dd>
                    {{/if}}
                    {{#if link}}
                    <dt>Link</dt>
                    <dd><a href="{{link}}" target="_blank">{{link}}</a></dd>
                    {{/if}}
                    {{#if category}}
                    <dt>Categories</dt>
                    <dd>
                    {{#each category}}
                        <a href="/activities#{{this}}" class="label label-info">{{this}}</a>
                    {{/each}}
                    </dd>
                    {{/if}}
                    <dt>Last Modified</dt>
                    <dd data-livestamp="{{time}}"></dd>
                </dl>
            </div> <!-- /.col-md-9 -->
        </div> <!-- /.row -->
    </div>
    {{/each}}
</div>
