<div class="section text-center container-fluid banner constrain" style="background-image:url('img/LargeBanner.png')">
    <img src="/img/logo.png" alt="Logo">
    <h3>Lorem ipsum dolor sit amet, consectetur adipiscing elit. In scelerisque maximus ipsum vitae ultrices.</h3>
</div>
<div class="section text-center container-fluid">
    <div class="page-header"><h2>Upcoming Events</h2></div>
    {{#unless upcoming}}
    <h3>There are currently no upcoming events</h3>
    {{else}}
    <div class="row">
        {{#each upcoming}}
        <div class="panel panel-info card">
            <div class="panel-heading">
                <h3 class="panel-title">{{title}}</h3>
            </div>
            <a data-toggle="lightbox" data-title="Placeholder" href="/img/EventPicture.png" class="thumbnail">
                <img src="/img/EventPicture.png" alt="Placeholder" class="constrain">
            </a>
            <div class="panel-body">
                <small>From</small>
                <p>{{start}}</p>
                <small>To</small>
                <p>{{end}}</p>
            </div>
            <div class="panel-footer">
                <a href="/upcoming#{{_id}}">View Information</a>
            </div>
        </div>
        {{/each}}
    </div>
    {{/unless}}
</div>
