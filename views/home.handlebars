<div id="fb-root"></div>
<script>(function(d, s, id) {
  var js, fjs = d.getElementsByTagName(s)[0];
  if (d.getElementById(id)) return;
  js = d.createElement(s); js.id = id;
  js.src = "//connect.facebook.net/en_GB/sdk.js#xfbml=1&version=v2.5";
  fjs.parentNode.insertBefore(js, fjs);
}(document, 'script', 'facebook-jssdk'));</script>
<div class="col-md-4">
    <div class="page-header">
        <h2>Home</h2>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
             Before you lies the Singapore Rovers information portal, where Rover Scouts may obtain the latest information on the movement and easily access important resources relating to Rover Scouting. Click on the tabs to find out more.
        </div>
    </div>
</div> <!-- /.col-md-4 -->
<div class="col-md-4">
    <div class="page-header">
        <h2>Latest Updates</h2>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="fb-page" data-href="https://www.facebook.com/Singapore-Rovers-121112262111/" data-tabs="timeline" data-small-header="true" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="false">Facebook plugin is loading...</div>
        </div>
    </div>
</div> <!-- /.col-md-4 -->
<div class="col-md-4">
    <div class="page-header">
        <h2>Upcoming Events</h2>
    </div>
    {{#unless events}}
    <div class="panel panel-info">
        <div class="panel-body">
            There are currently no upcoming events.
        </div>
    </div> <!-- /.panel -->
    {{else}}
    <table class="table table-striped table-bordered sortable">
        <thead>
            <tr>
                <th class="col-md-4">Name</th>
                <th class="col-md-4"></th>
                <th class="col-md-4" data-defaultsort="asc" data-firstsort="desc">Date</th>
            </tr>
        </thead>
        <tbody>
            {{#each upcoming}}
            <tr>
                <td><a href="/events/view/{{this._id}}">{{this.title}}</a></td>
                {{#if this.started}}
                <td>Ending</td>
                <td data-value="{{this.end}}" data-livestamp="{{this.end}}"></td>
                {{else}}
                <td>Starting</td>
                <td data-value="{{this.start}}" data-livestamp="{{this.start}}"></td>
                {{/if}}
            </tr>
            {{/each}}
            {{#if more}}
            <tr>
                <td colspan="3">
                    <a href="/events/">View All Events <i class="fa fa-arrow-circle-right"></i></a>
                </td>
            </tr>
            {{/if}}
        </tbody>
    </table> <!-- /.table -->
    {{/unless}}
</div> <!-- /.col-md-4 -->