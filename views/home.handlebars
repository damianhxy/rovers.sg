<div id="fb-root"></div>
<script>(function(d, s, id) {
  var js, fjs = d.getElementsByTagName(s)[0];
  if (d.getElementById(id)) return;
  js = d.createElement(s); js.id = id;
  js.src = "//connect.facebook.net/en_GB/sdk.js#xfbml=1&version=v2.5";
  fjs.parentNode.insertBefore(js, fjs);
}(document, 'script', 'facebook-jssdk'));</script>
<div class="col-md-8 col-md-offset-2">
    <a data-toggle="lightbox" href="/img/quote.png" data-title="Quote">
        <img alt="Quote" class="center-block constrain" title="Click to enlarge image" src="/img/quote.png">
    </a>
</div> <!-- /.col-md-8 -->
<div class="col-md-4 text-center">
    <div class="fb-page" data-href="https://www.facebook.com/Singapore-Rovers-121112262111/" data-tabs="timeline,events,messages" data-small-header="true" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="false">Facebook plugin is loading...</div>
</div> <!-- /.col-md-4 -->
<div class="col-md-4">
    <div class="panel panel-default">
        <div class="panel-heading">
            <span class="h3 panel-title">Media</span>
            <div class="btn-group pull-right">
                <button class="btn btn-xs btn-default carousel-prev"><i class="fa fa-arrow-circle-left"></i></button>
                <button class="btn btn-xs btn-default carousel-next"><i class="fa fa-arrow-circle-right"></i></button>
            </div>
        </div>
        <div class="panel-body">
            <div class="slick">
                <div>
                    <a data-toggle="lightbox" href="/img/Blood Drive.jpg" data-title="Blood Drive">
                        <img alt="Blood Drive" class="constrain" title="Click to view larger image" src="/img/cropped/Blood Drive.jpg">
                    </a>
                    <h3>Blood Drive</h3>
                </div>
                <div>
                    <a data-toggle="lightbox" href="/img/Project Orion.jpg" data-title="Project Orion">
                        <img alt="Project Orion" class="constrain" title="Click to view larger image" src="/img/cropped/Project Orion.jpg">
                    </a>
                    <h3>Project Orion</h3>
                </div>
                <div>
                    <a data-toggle="lightbox" href="/img/Gunung Rinjani.jpg" data-title="Gunung Rinjani">
                        <img alt="Gunung Rinjani" class="constrain" title="Click to view larger image" src="/img/cropped/Gunung Rinjani.jpg">
                    </a>
                    <h3>Gunung Rinjani</h3>
                </div>
                <div>
                    <a data-toggle="lightbox" href="/img/World Scout Youth Forum.jpg" data-title="World Scout Youth Forum">
                        <img alt="World Scout Youth Forum" class="constrain" title="Click to enlarge image" src="/img/cropped/World Scout Youth Forum.jpg">
                    </a>
                    <h3>World Scout Youth Forum</h3>
                </div>
            </div> <!-- /.slick -->
        </div>
    </div>
</div> <!-- /.col-md-4 -->
<div class="col-md-4">
    {{#unless upcoming}}
    <div class="panel panel-info">
        <div class="panel-body">
            There are currently no upcoming events.
        </div>
    </div> <!-- /.panel -->
    {{else}}
    <table class="table table-striped table-bordered sortable">
        <thead>
            <tr>
                <th class="col-md-6">Name</th>
                <th class="col-md-6" data-defaultsort="asc" data-firstsort="desc">Date</th>
            </tr>
        </thead>
        <tbody>
            {{#each upcoming}}
            <tr>
                <td><a href="/events/{{this._id}}">{{this.title}}</a></td>
                {{#if this.started}}
                <td data-value="{{this.end}}">Ending <span data-livestamp="{{this.end}}"></span></td>
                {{else}}
                <td data-value="{{this.start}}">Starting <span data-livestamp="{{this.start}}"></span></td>
                {{/if}}
            </tr>
            {{/each}}
            {{#if more}}
            <tr>
                <td colspan="3">
                    <a href="/events/">View More Events <i class="fa fa-arrow-circle-right"></i></a>
                </td>
            </tr>
            {{/if}}
        </tbody>
    </table> <!-- /.table -->
    {{/unless}}
</div> <!-- /.col-md-4 -->
