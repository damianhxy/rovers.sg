<div class="col-md-6">
    <div class="page-header">
        <span class="h1">Home</span>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            Before you lies the Singapore Rovers information portal, where Rover Scouts may obtain the latest information on the movement and easily access important resources relating to Rover Scouting. Click on the tabs to find out more.
        </div>
    </div> <!-- /.panel -->
</div> <!-- /.col-md-6 -->
<div class="col-md-6">
    <div class="page-header">
        <span class="h1">Upcoming Events</span>
    </div>
    {{#unless events}}
    <div class="panel panel-info">
        <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-info-circle"></i> Empty</h3>
        </div>
        <div class="panel-body">
            There are currently no upcoming events.
        </div>
    </div> <!-- /.panel -->
    {{else}}
    <table class="table table-striped table-bordered sortable">
        <thead>
            <tr>
                <th class="col-md-4">Name</th>
                <th class="col-md-4">Start</th>
                <th class="col-md-4">End</th>
            </tr>
        </thead>
        <tbody>
            {{#each events}}
            <tr>
                <td><a href="/events/view/{{this._id}}">{{this.title}}</a></td>
                <td data-value="{{this.start}}" data-livestamp="{{this.start}}"></td>
                <td data-value="{{this.end}}" data-livestamp="{{this.end}}"></td>
            </tr>
            {{/each}}
            {{#if more}}
            <tr>
                <td class="table--footer" colspan="3">
                    <a href="/events/">View More Events <i class="fa fa-arrow-circle-right"></i></a>
                </td>
            </tr>
            {{/if}}
        </tbody>
    </table> <!-- /.table -->
    {{/unless}}
</div> <!-- /.col-md-6 -->