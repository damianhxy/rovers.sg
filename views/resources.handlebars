<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group" id="shortcuts">
                {{#each categories}}
                <a class="list-group-item" href="#{{name}}">{{@key}}</a>
                {{/each}}
                <a class="list-group-item" href="#upload-file">Upload File</a>
            </div>
        </div> <!-- /.col-md-3 -->
        <div class="col-md-9">
            {{#each categories}}
            <div class="anchor" id="{{name}}"></div>
            <div class="section text-center">
                <h2>{{@key}}</h2>
                {{#unless fileList}}
                <h3>There are currently no files in this category</h3>
                {{else}}
                    {{#each fileList}}
                    <div class="panel panel-info card" id={{_id}} data-name="{{name}}" data-time="{{time}}">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-{{fileType name}}"></i> {{name}}</h3>
                        </div>
                        <div class="panel-body">
                            <small>Description</small>
                            <p><a class="field-edit" data-type="text" data-pk="{{_id}}" data-name="description" data-url="/resources" data-title="Enter Description">{{description}}</a></p>
                        </div>
                        <div class="panel-footer">
                            <div class="btn-group">
                                <a href="/uploads/{{name}}" class="btn btn-info btn-xs">
                                    <i class="fa fa-cloud-download"></i> Download
                                </a>
                                {{#if ../../../user.admin}}
                                <button class="btn btn-success btn-xs btn-edit"><i class="fa fa-edit"></i> Edit</button>
                                <a href="#deleteModal" class="btn btn-danger btn-xs" data-toggle="modal">
                                    <i class="fa fa-close"></i> Delete
                                </a>
                                {{/if}}
                            </div>
                        </div>
                        <div class="panel-footer">
                            <small>Last modified <span data-livestamp="{{time}}"></span></small>
                        </div>
                    </div>
                    {{/each}}
                {{/unless}}
            </div> <!-- /.section -->
            {{/each}}
            {{#if user.admin}}
            <div class="anchor" id="upload-file"></div>
            <div class="section text-center container-fluid">
                <h2>Upload File</h2>
                <div class="col-md-6 col-md-offset-3">
                    <form id="uploadForm" class="form-horizontal" action="/resources" method="post" accept-charset="UTF-8" enctype="multipart/form-data" autocomplete="off">
                        <div class="form-group">
                            <span class="col-md-2 control-label">File</span>
                            <div class="col-md-10">
                                <div class="input-group">
                                    <input id="upload-name" type="text" class="form-control" value="No File Selected" disabled>
                                    <span class="input-group-btn">
                                        <span class="btn btn-info btn-file">
                                            <span>Browse...</span>
                                            <input type="file" name="file">
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div> <!-- /.form-group -->
                        <div class="form-group">
                            <span class="col-md-2 control-label">Category</span>
                            <div class="col-md-10">
                                <select class="form-control" name="category" required>
                                    {{#each categories}}
                                    <option value="{{@key}}">{{@key}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div> <!-- /.form-group -->
                        <div class="form-group">
                            <span class="col-md-2 control-label">Description</span>
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="description" placeholder="Optional">
                            </div>
                        </div> <!-- /.form-group -->
                        <div class="form-group">
                            <div class="col-md-10 col-md-offset-2">
                                <button type="submit" class="btn btn-success col-md-4">Upload File</button>
                            </div>
                        </div> <!-- /.form-group -->
                    </form>
                </div> <!-- /.col-md-6 -->
            </div> <!-- /.section -->
            <div class="section text-center container-fluid">
                <div class="row">
                    <div class="col-md-6">
                        <h2>Add Form</h2>
                        <form class="form-horizontal" action="/forms" method="post" accept-charset="UTF-8" autocomplete="off">
                            <div class="form-group">
                                <span class="col-md-2 control-label">Name</span>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" name="name" required>
                                </div>
                            </div> <!-- /.form-group -->
                            <div class="form-group">
                                <span class="col-md-2 control-label">Short URL</span>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" name="url" required>
                                </div>
                            </div> <!-- /.form-group -->
                            <div class="form-group">
                                <span class="col-md-2 control-label">Embed</span>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" name="embed" placeholder="https://docs.google.com..." required>
                                </div>
                            </div> <!-- /.form-group -->
                            <div class="form-group">
                                <div class="col-md-10 col-md-offset-2">
                                    <button type="submit" class="btn btn-success col-md-4">Add form</button>
                                </div>
                            </div> <!-- /.form-group -->
                        </form>
                    </div> <!-- /.col-md-6 -->
                    <div class="col-md-6">
                        <h2>Delete Form</h2>
                        <form class="form-horizontal" action="/forms?_method=DELETE" method="post" accept-charset="UTF-8" autocomplete="off">
                            <div class="form-group">
                                <span class="col-md-2 control-label">Short URL</span>
                                <div class="col-md-10">
                                    <select class="form-control" name="url">
                                        {{#each forms}}
                                        <option value="{{this.url}}">{{this.url}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                            </div> <!-- /.form-group -->
                            <div class="form-group">
                                <div class="col-md-10 col-md-offset-2">
                                    <button type="submit" class="btn btn-danger col-md-4">Remove Form</button>
                                </div>
                            </div>  <!-- /.form-group -->
                        </form>
                    </div> <!-- /.col-md-6 -->
                </div> <!-- /.row -->
                <table class="table table-striped table-bordered sortable" data-sortable>
                    <thead>
                        <tr>
                            <th class="col-md-3 col-xs-6">Name</th>
                            <th class="col-md-3 hidden-xs">Short URL</th>
                            <th class="col-md-3 hidden-xs">Embed</th>
                            <th class="col-md-3 col-xs-6" data-defaultsort="desc" data-firstsort="asc">Added</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each ../forms}}
                        <tr>
                            <td><a href="/forms/{{this.url}}">{{this.name}}</a></td>
                            <td class="hidden-xs">{{this.url}}</td>
                            <td class="wrap hidden-xs"><a href={{this.embed}}>{{this.embed}}</a></td>
                            <td data-value="{{this.time}}" data-livestamp="{{this.time}}"></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table> <!-- /.table -->
            </div> <!-- /.section -->
            {{/if}}
        </div> <!-- /.col-md-9 -->
        <!-- deleteModal -->
        <div id="deleteModal" class="modal fade" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <i class="fa fa-times"></i>
                        </button>
                        <h4 class="modal-title">Delete File</h4>
                    </div>
                    <div class="modal-body">
                        <p id="modalFileName"></p>
                        <p id="modalFileTime"></p>
                        <p>Are you sure? This file will be <strong>permanently</strong> deleted.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger">Delete</button>
                    </div>
                </div>
            </div>
        </div> <!-- #deleteModal -->
    </div> <!-- /.row -->
</div> <!-- /.container-fluid -->
<script src="/lib/custom/resources.js"></script>
