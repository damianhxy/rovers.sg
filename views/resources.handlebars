<div class="container">
    <div class="row">
        <div class="col-md-3 hidden-sm hidden-xs">
            <div class="list-group text-center shortcuts">
                {{#each categories}}
                <a class="list-group-item" href="#{{name}}">{{@key}}</a>
                {{/each}}
                {{#if user.admin}}
                <a class="list-group-item" href="#upload-file">Upload Resource</a>
                {{/if}}
            </div>
        </div> <!-- /.col-md-3 -->
        <div class="col-md-9">
            {{#each categories}}
            <a class="anchor" id="{{name}}"></a>
            <div class="section text-center">
                <div class="page-header"><h2>{{@key}}</h2></div>
                {{> resourceCardList fileList}}
            </div> <!-- /.section -->
            {{/each}}
            {{#if user.admin}}
            <a class="anchor" id="upload-file"></a>
            <div class="section">
                <div class="page-header text-center"><h2>Upload Resource</h2></div>
                <form id="uploadForm" class="form-horizontal" action="/resources" method="post" accept-charset="UTF-8" enctype="multipart/form-data" autocomplete="off">
                    <div class="form-group">
                        <span class="col-md-2 control-label">File</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <div class="input-group-addon">Max Size: 25MB</div>
                                <input id="uploadName" type="text" class="form-control" value="No File Selected" readonly>
                                <span class="input-group-btn">
                                    <span class="btn btn-primary btn-file">
                                        <span>Browse...</span>
                                        <input type="file" name="file">
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <span class="col-md-2 control-label">or URL</span>
                        <div class="col-md-10">
                            <input type="text" class="form-control" name="url">
                        </div>
                    </div>
                    <hr class="separator">
                    <div class="form-group">
                        <span class="col-md-2 control-label">Name</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input type="text" class="form-control" name="name" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <span class="col-md-2 control-label">Category</span>
                        <div class="col-md-10">
                            <select class="form-control" name="category" required>
                                {{#each categories}}
                                <option value="{{@key}}">{{@key}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <span class="col-md-2 control-label">Description</span>
                        <div class="col-md-10">
                            <textarea class="form-control" name="description" rows="3"></textarea>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <div class="col-md-10 col-md-offset-2">
                            <div class="btn-group">
                                <button type="submit" class="btn btn-success"><i class="fa fa-cloud-upload"></i> Upload Resource</button>
                                <button type="reset" class="btn btn-danger"><i class="fa fa-times-circle"></i> Reset Form</button>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                </form>
            </div> <!-- /.section -->
            {{/if}}
        </div> <!-- /.col-md-9 -->
    </div> <!-- /.row -->
</div> <!-- /.container -->
<script src="/js/custom/resources.js"></script>
