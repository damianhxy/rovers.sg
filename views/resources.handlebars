<div class="col-md-12">
    <div class="page-header">
        <h1>Resources</h1>
    </div>
</div>
<div class="col-md-3">
    <ul class="nav nav-pills nav-stacked">
        {{#each categories}}
        <li><a href="#{{this.name}}" data-toggle="pill">
            <i class="fa fa-{{this.icon}}"></i> {{@key}}
        </a></li>
        {{/each}}
        <li><a href="#links" data-toggle="pill"><i class="fa fa-external-link"></i> Links</a></li>
        {{#if user.admin}}
        <li><a href="#upload" data-toggle="pill"><i class="fa fa-upload"></i> Upload File</a></li>
        {{/if}}
    </ul>
</div> <!-- /.col-md-3 -->
<div class="col-md-9 tab-content">
    {{#each categories}}
    <div id="{{this.name}}" class="tab-pane fade">
        {{#unless this.fileList}}
        <div class="panel panel-info">
            <div class="panel-body">
                There are currently no files in this category.
            </div>
        </div> <!-- /.panel -->
        {{else}}
        <table class="table table-striped table-bordered sortable">
            <thead>
                <tr>
                    {{#if ../../user.admin}}
                    <th class="col-md-4 col-sm-5 col-xs-8">File</th>
                    <th class="col-md-4 col-sm-5 hidden-xs">Description</th>
                    <th class="col-md-2 hidden-sm hidden-xs" data-defaultsort="desc" data-firstsort="asc">Last Modified</th>
                    <th class="col-md-2 col-sm-2 col-xs-4" data-defaultsort="disabled">Actions</th>
                    {{else}}
                    <th class="col-md-4 col-sm-6 col-xs-12">File</th>
                    <th class="col-md-4 col-sm-6 hidden-xs">Description</th>
                    <th class="col-md-4 hidden-sm hidden-xs" data-defaultsort="desc" data-firstsort="asc">Last Modified</th>
                    {{/if}}
                </tr>
            </thead>
            <tbody>
                {{#each this.fileList}}
                <tr data-id="{{this._id}}">
                    <td>
                        <a href="/uploads/{{this.name}}">
                            <i class="fa fa-{{fileType this.name}}"></i> {{this.name}}
                        </a>
                    </td>
                    <td class="hidden-xs">
                        <a class="field-edit" data-name="description" href="#">
                            {{this.description}}
                        </a>
                    </td>
                    <td class="hidden-sm hidden-xs" data-value="{{this.time}}" data-livestamp="{{this.time}}">
                    </td>
                    {{#if ../../../user.admin}}
                    <td data-name="{{this.name}}">
                        <div class="btn-group">
                            <button type="button" class="btn btn-success btn-xs btn-edit">
                                <i class="fa fa-edit"> Edit</i>
                            </button>
                            <a href="#deleteModal" class="btn btn-danger btn-xs" data-toggle="modal">
                                <i class="fa fa-close"> Delete</i>
                            </a>
                        </div> <!-- /.btn-group -->
                    </td>
                    {{/if}}
                </tr>
                {{/each}}
            </tbody>
        </table> <!-- /.table -->
        {{/unless}}
    </div>
    {{/each}}
    <div id="links" class="tab-pane fade">
        <table class="table table-striped table-bordered sortable" data-sortable>
            <thead>
                <tr>
                    <th class="col-md-6">Name</th>
                    <th class="col-md-6">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><a href="http://scout.sg/">Scout.sg</a></td>
                    <td>Singapore Scout Association's official website</td>
                </tr>
                <tr>
                    <td><a href="https://fb.com/SingaporeScouts">Singapore Scouts Facebook</a></td>
                    <td>Official Facebook page of Singapore Scouts</td>
                </tr>
                <tr>
                    <td><a href="https://fb.com/pages/Singapore-Rovers/121112262111">Singapore Rovers Facebook</a></td>
                    <td>Official Facebook page of Singapore Rovers</td>
                </tr>
                <tr>
                    <td><a href="http://www.thedump.scoutscan.com/scouts.html">Scout Dump</a></td>
                    <td>Archive of useful Scout related materials</td>
                </tr>
                <tr>
                    <td><a href="https://www.scout.org/">Scout.org</a></td>
                    <td>World Organisation of the Scout Movement's official website</td>
                </tr>
            </tbody>
        </table> <!-- /.table -->
    </div>
    {{#if user.admin}}
    <div id="upload" class="tab-pane fade">
        <form id="uploadForm" class="form-horizontal" action="/resources/upload" method="post" accept-charset="UTF-8" enctype="multipart/form-data" autocomplete="off">
            <fieldset>
                <legend>File Upload</legend>
                <div class="form-group">
                    <span class="col-md-2 control-label">File</span>
                    <div class="col-md-10">
                        <div class="input-group">
                            <input id="upload-name" type="text" class="form-control" value="No File Selected" disabled>
                            <span class="input-group-btn">
                                <span class="btn btn-info btn-file">
                                    <span>Browse...</span>
                                    <input type="file" name="file">
                                </span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <span class="col-md-2 control-label">Category</span>
                    <div class="col-md-10">
                        <select class="form-control" name="category" required>
                            {{#each categories}}
                            <option value="{{@key}}">{{@key}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <span class="col-md-2 control-label">Description</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="description" placeholder="Optional">
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-10 col-md-offset-2">
                        <button type="submit" class="btn btn-success col-md-4">Upload File</button>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>
    <!-- deleteModal -->
    <div id="deleteModal" class="modal fade" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times"></i>
                    </button>
                    <h4 class="modal-title">Delete File</h4>
                </div>
                <div class="modal-body">
                    <p id="modalFileName"></p>
                    <p id="modalFileTime"></p>
                    <p>Are you sure? This file will be <strong>permanently</strong> deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
</div> <!-- /.col-md-9 -->
<script src="/lib/custom/resources.js"></script>
