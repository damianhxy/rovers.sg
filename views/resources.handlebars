<div class="col-md-12">
    <div class="page-header">
        <span class="h1">Resources <small>Files</small></span>
    </div>
</div>
<div class="col-md-3">
    <ul class="nav nav-pills nav-stacked">
        <li role="presentation">
            <a href="#info" data-toggle="pill"><i class="fa fa-info-circle"></i> Latest Information</a>
        </li>
        <li role="presentation">
            <a href="#forms" data-toggle="pill"><i class="fa fa-edit"></i> Forms</a>
        </li>
        <li role="presentation">
            <a href="#policies" data-toggle="pill"><i class="fa fa-university"></i> Policies</a>
        </li>
        <li role="presentation">
            <a href="#scheme" data-toggle="pill"><i class="fa fa-bullseye"></i> Progress Scheme</a>
        </li>
        <li role="presentation">
            <a href="#others" data-toggle="pill"><i class="fa fa-certificate"></i> Others</a>
        </li>
        {{#if user}}
        <li><a href="#upload" data-toggle="pill"><i class="fa fa-upload"></i> Upload File</a></li>
        {{/if}}
    </ul>
</div> <!-- /.col-md-3 -->
<div class="col-md-9 tab-content">
    {{#each category}}
    <div id="{{this.name}}" class="tab-pane fade">
        {{#if this.isEmpty}}
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-info-circle"></i> Empty</h3>
            </div>
            <div class="panel-body">
                There are currently no files in this category.
            </div>
        </div> <!-- /.panel -->
        {{else}}
        <table class="table table-striped table-bordered sortable">
            <thead>
                <tr>
                    {{#if ../../user}}
                    <th class="col-md-4">Title</th>
                    <th class="col-md-4">File</th>
                    <th class="col-md-2" data-defaultsort="desc" data-firstsort="asc">Last Modified</th>
                    <th class="col-md-2" data-defaultsort="disabled">Actions</th>
                    {{else}}
                    <th class="col-md-4">Title</th>
                    <th class="col-md-4">File</th>
                    <th class="col-md-4" data-defaultsort="desc" data-firstsort="asc">Last Modified</th>
                    {{/if}}
                </tr>
            </thead>
            <tbody>
                {{#each this.fileList}}
                <tr>
                    <td><a id="{{this._id}}" class="edit-title">{{this.title}}</a></td>
                    <td>
                        <a href="/uploads/{{this.name}}" data-title="{{this.title}}" download>
                            <i class="fa fa-{{fileType this.original}}"></i> {{this.original}}
                        </a>
                    </td>
                    <td data-value="{{this.time}}" data-livestamp="{{this.time}}">
                    </td>
                    {{#if ../../../user.admin}}
                    <td data-original="{{this.original}}" data-id="{{this._id}}">
                        <div class="btn-group">
                            <button type="button" class="btn btn-success btn-xs">
                                <i class="fa fa-edit"> Edit</i>
                            </button>
                            <a href="#deleteModal" class="btn btn-danger btn-xs" data-toggle="modal">
                                <i class="fa fa-close"> Delete</i>
                            </a>
                        </div> <!-- /.btn-group -->
                    </td>
                    {{/if}}
                </tr>
                {{/each}}
            </tbody>
        </table> <!-- /table -->
        {{/if}}
    </div>
    {{/each}}
    {{#if user}}
    <div id="upload" class="tab-pane fade">
        <form class="form-horizontal" action="/resource/upload" method="post" accept-charset="UTF-8" role="form" enctype="multipart/form-data">
            <legend>File Upload</legend>
            <div class="form-group">
                <span class="col-md-2 control-label">File Title</span>
                <div class="col-md-10">
                    <input id="fileTitle" name="title" class="form-control" type="text" required>
                </div>
            </div> <!-- /.form-group -->
            <div class="form-group">
                <span class="col-md-2 control-label">Category</span>
                <div class="col-md-10">
                    <select name="category" class="form-control" required>
                        <option value="Latest Information">Latest Information</option>
                        <option value="Forms">Forms</option>
                        <option value="Policies">Policies</option>
                        <option value="Progress Scheme">Progress Scheme</option>
                        <option value="Others">Others</option>
                    </select>
                </div> <!-- /.col-md-10 -->
            </div> <!-- /.form-group -->
            <div class="form-group">
                <span class="col-md-2 control-label">File</span>
                <div class="col-md-10">
                    <div class="input-group">
                        <input id="fileName" class="form-control" type="text" value="No File Selected." readonly>
                        <span class="input-group-btn">
                            <span class="btn btn-info btn-file">
                                <span>Browse...</span>
                                <input type="file" name="file">
                            </span>
                        </span>
                    </div>
                </div> <!-- /.col-md-10 -->
            </div> <!-- /.form-group -->
            <div class="form-group">
                <span class="col-md-2 control-label">Actions</span>
                <div class="col-md-10">
                    <div class="btn-group" role="group">
                        <button type="submit" class="btn btn-success">Upload</button>
                        <button type="reset" class="btn btn-danger">Clear</button>
                    </div> <!-- /.btn-group -->
                </div> <!-- /.col-md-10 -->
            </div> <!-- /.form-group -->
        </form>
    </div>
    <!-- deleteModal -->
    <div id="deleteModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times"></i>
                    </button>
                    <h4 class="modal-title">Delete File</h4>
                </div>
                <div class="modal-body">
                    <p id="modalFileName"></p>
                    <p id="modalFileTime"></p>
                    <p>Are you sure? This file will be <strong>permanently</strong> deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
</div> <!-- /.col-md-9 -->