<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group" id="shortcuts">
                {{#each categories}}
                <a class="list-group-item" href="#{{name}}">{{@key}}</a>
                {{/each}}
                <a class="list-group-item" href="#upload-file">Upload Resource</a>
            </div>
        </div> <!-- /.col-md-3 -->
        <div class="col-md-9">
            {{#each categories}}
            <div class="anchor" id="{{name}}"></div>
            <div class="section text-center">
                <div class="page-header"><h2>{{@key}}</h2></div>
                {{#unless fileList}}
                <h3>There are currently no resources in this category</h3>
                {{else}}
                    {{#each fileList}}
                        <div class="panel panel-info card" id={{_id}} data-name="{{name}}" data-time="{{time}}">
                            <div class="panel-heading">
                                <h3 class="panel-title"><i class="fa fa-{{fileType name}}"></i> {{name}}</h3>
                            </div>
                            <div class="panel-body">
                                <small>Description</small>
                                <p><a class="field-edit" data-type="text" data-pk="{{_id}}" data-name="description" data-url="/resources" data-title="Enter Description">{{description}}</a></p>
                            </div>
                            <div class="panel-footer">
                                <div class="btn-group">
                                    {{#unless url}}
                                    <a href="/uploads/{{name}}" class="btn btn-info btn-xs">
                                    {{else}}
                                    <a href="{{url}}" class="btn btn-info btn-xs">
                                    {{/unless}}
                                        <i class="fa fa-cloud-download"></i> Download
                                    </a>
                                    {{#if ../../../user.admin}}
                                    <button class="btn btn-success btn-xs btn-edit"><i class="fa fa-edit"></i> Edit</button>
                                    <a href="#deleteModal" class="btn btn-danger btn-xs" data-toggle="modal">
                                        <i class="fa fa-close"></i> Delete
                                    </a>
                                    {{/if}}
                                </div>
                            </div>
                            <div class="panel-footer">
                                <small>Last modified <span data-livestamp="{{time}}"></span></small>
                            </div>
                        </div>
                    {{/each}}
                {{/unless}}
            </div> <!-- /.section -->
            {{/each}}
            {{#if user.admin}}
            <div class="anchor" id="upload-file"></div>
            <div class="section text-center container-fluid">
                <div class="page-header"><h2>Upload Resource</h2></div>
                <div class="row">
                    <form id="uploadForm" class="form-horizontal" action="/resources" method="post" accept-charset="UTF-8" enctype="multipart/form-data" autocomplete="off">
                        <div class="form-group">
                            <span class="col-md-2 control-label">File</span>
                            <div class="col-md-10">
                                <div class="input-group">
                                    <input id="upload-name" type="text" class="form-control" value="No File Selected" disabled>
                                    <span class="input-group-btn">
                                        <span class="btn btn-info btn-file">
                                            <span>Browse...</span>
                                            <input type="file" name="file">
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div> <!-- /.form-group -->
                        <h3>OR</h3>
                        <div class="form-group">
                            <span class="col-md-2 control-label">URL</span>
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="url">
                            </div>
                        </div>
                        <hr class="separator">
                        <div class="form-group">
                            <span class="col-md-2 control-label">Name</span>
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="name" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <span class="col-md-2 control-label">Category</span>
                            <div class="col-md-10">
                                <select class="form-control" name="category" required>
                                    {{#each categories}}
                                    <option value="{{@key}}">{{@key}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div> <!-- /.form-group -->
                        <div class="form-group">
                            <span class="col-md-2 control-label">Description</span>
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="description" placeholder="Optional">
                            </div>
                        </div> <!-- /.form-group -->
                        <div class="form-group">
                            <div class="col-md-10 col-md-offset-2">
                                <button type="submit" class="btn btn-success col-md-4">Upload File</button>
                            </div>
                        </div> <!-- /.form-group -->
                    </form>
                </div> <!-- /.row -->
            </div> <!-- /.section -->
            {{/if}}
        </div> <!-- /.col-md-9 -->
    </div> <!-- /.row -->
</div> <!-- /.container-fluid -->
<!-- deleteModal -->
<div id="deleteModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="fa fa-times"></i>
                </button>
                <h4 class="modal-title">Delete File</h4>
            </div>
            <div class="modal-body">
                <p id="modalFileName"></p>
                <p id="modalFileTime"></p>
                <p>Are you sure? This file will be <strong>permanently</strong> deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div> <!-- #deleteModal -->
<script src="/lib/custom/resources.js"></script>
