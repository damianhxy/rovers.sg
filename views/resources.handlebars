<div class="col-md-12">
    <div class="page-header">
        <span class="h1">Resources</span>
    </div>
</div>
<div class="col-md-3">
    <ul class="nav nav-pills nav-stacked">
        {{#each categories}}
        <li role="presentation"><a href="#{{this.name}}" data-toggle="pill">
            <i class="fa fa-{{this.icon}}"></i> {{@key}}
        </a></li>
        {{/each}}
        {{#if user}}
        <li><a href="#upload" data-toggle="pill"><i class="fa fa-upload"></i> Upload File</a></li>
        {{/if}}
    </ul>
</div> <!-- /.col-md-3 -->
<div class="col-md-9 tab-content">
    {{#each categories}}
    <div id="{{this.name}}" class="tab-pane fade">
        {{#if this.isEmpty}}
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-info-circle"></i> Empty</h3>
            </div>
            <div class="panel-body">
                There are currently no files in this category.
            </div>
        </div> <!-- /.panel -->
        {{else}}
        <table class="table table-striped table-bordered sortable">
            <thead>
                <tr>
                    {{#if ../../user}}
                    <th class="col-md-4">File</th>
                    <th class="col-md-4">Description</th>
                    <th class="col-md-2" data-defaultsort="desc" data-firstsort="asc">Last Modified</th>
                    <th class="col-md-2" data-defaultsort="disabled">Actions</th>
                    {{else}}
                    <th class="col-md-4">File</th>
                    <th class="col-md-4">Description</th>
                    <th class="col-md-4" data-defaultsort="desc" data-firstsort="asc">Last Modified</th>
                    {{/if}}
                </tr>
            </thead>
            <tbody>
                {{#each this.fileList}}
                <tr>
                    <td>
                        <a href="/uploads/{{this.name}}" download>
                            <i class="fa fa-{{fileType this.original}}"></i> {{this.original}}
                        </a>
                    </td>
                    <td>
                        <a id="{{this._id}}" class="field-edit" href="#">
                            {{this.description}}
                        </a>
                    </td>
                    <td data-value="{{this.time}}" data-livestamp="{{this.time}}">
                    </td>
                    {{#if ../../../user.admin}}
                    <td data-original="{{this.original}}" data-id="{{this._id}}">
                        <div class="btn-group">
                            <button type="button" class="btn btn-success btn-xs btn-edit">
                                <i class="fa fa-edit"> Edit</i>
                            </button>
                            <a href="#deleteModal" class="btn btn-danger btn-xs" data-toggle="modal">
                                <i class="fa fa-close"> Delete</i>
                            </a>
                        </div> <!-- /.btn-group -->
                    </td>
                    {{/if}}
                </tr>
                {{/each}}
            </tbody>
        </table> <!-- /.table -->
        {{/if}}
    </div>
    {{/each}}
    {{#if user.admin}}
    <div id="upload" class="tab-pane fade">
        <form class="form-horizontal" action="/resources/upload" method="post" accept-charset="UTF-8" enctype="multipart/form-data" autocomplete="off">
            <fieldset>
                <legend>File Upload</legend>
                <div class="form-group">
                    <span class="col-md-2 control-label">File</span>
                    <div class="col-md-10">
                        <div class="input-group">
                            <input id="upload-name" type="text" class="form-control" value="No File Selected" disabled>
                            <span class="input-group-btn">
                                <span class="btn btn-info btn-file">
                                    <span>Browse...</span>
                                    <input type="file" name="file">
                                </span>
                            </span>
                        </div>
                    </div> <!-- /.col-md-10 -->
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Category</span>
                    <div class="col-md-10">
                        <select class="form-control" name="category" required>
                            {{#each categories}}
                            <option value="{{@key}}">{{@key}}</option>
                            {{/each}}
                        </select>
                    </div> <!-- /.col-md-10 -->
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Description</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="description" placeholder="Optional">
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <div class="col-md-10 col-md-offset-2">
                        <button type="submit" class="btn btn-success col-md-4">Upload</button>
                    </div> <!-- /.col-md-10 -->
                </div> <!-- /.form-group -->
            </fieldset>
        </form>
    </div>
    <!-- deleteModal -->
    <div id="deleteModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times"></i>
                    </button>
                    <h4 class="modal-title">Delete File</h4>
                </div>
                <div class="modal-body">
                    <p id="modalFileName"></p>
                    <p id="modalFileTime"></p>
                    <p>Are you sure? This file will be <strong>permanently</strong> deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
</div> <!-- /.col-md-9 -->