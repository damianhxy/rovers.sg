<main class="container-fluid">
    <div class="col-lg-12">
        <div class="page-header">
            <span class="h1">Resources <small>Files</small></span>
        </div>
    </div>
    <div class="col-lg-3">
        <ul class="nav nav-pills nav-stacked">
            <li role="presentation">
                <a href="#info" data-toggle="pill"><i class="fa fa-info-circle" aria-hidden="true"></i>&nbsp;Latest Information</a>
            </li>
            <li role="presentation">
                <a href="#forms" data-toggle="pill"><i class="fa fa-edit" aria-hidden="true"></i>&nbsp;Forms</a>
            </li>
            <li role="presentation">
                <a href="#policies" data-toggle="pill"><i class="fa fa-university" aria-hidden="true"></i>&nbsp;Policies</a>
            </li>
            <li role="presentation">
                <a href="#scheme" data-toggle="pill"><i class="fa fa-bullseye" aria-hidden="true"></i>&nbsp;Progress Scheme</a>
            </li>
            <li role="presentation">
                <a href="#others" data-toggle="pill"><i class="fa fa-certificate" aria-hidden="true"></i>&nbsp;Others</a>
            </li>
            {{#if user}}
            <li><a href="#upload" data-toggle="pill"><i class="fa fa-cloud-upload" aria-hidden="true"></i>&nbsp;Upload File</a></li>
            {{/if}}
        </ul>
    </div> <!-- /.col-lg-3 -->
    <div class="col-lg-9 tab-content">
        {{#each category}}
        <div id="{{this.name}}" class="tab-pane fade">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        {{#if ../user}}
                        <th class="col-lg-2">Title</th>
                        <th class="col-lg-2">File</th>
                        <th class="col-lg-2">File Size</th>
                        <th class="col-lg-3">Last Modified</th>
                        <th class="col-lg-3 no-sort">Actions</th>
                        {{else}}
                        <th class="col-lg-3">Title</th>
                        <th class="col-lg-3">File</th>
                        <th class="col-lg-3">File Size</th>
                        <th class="col-lg-3">Last Modified</th>
                        {{/if}}
                    </tr>
                </thead>
                <tbody>
                    {{#each this.filelist}}
                    <tr>
                        <td><a id="edit-{{this._id}}">{{this.title}}</a></td>
                        <td>
                            <a class="fancybox" href="/files/{{this.name}}" title="{{this.title}}" rel="media">
                                <i class="fa fa-{{fileType this.name}}"></i>&nbsp;{{this.original}}
                            </a>
                        </td>
                        <td>{{this.size}}</td>
                        <td>{{this.time}}</td>
                        {{#if ../../user}}
                        <td data-original="{{this.original}}" data-id="{{this._id}}">
                            <button class="edit-btn btn btn-success btn-xs" role="button">
                                <i class="fa fa-edit" aria-hidden="true">&nbsp;Edit Details</i>
                            </button>
                            <a href="#deleteModal" role="button" class="btn btn-danger btn-xs" data-toggle="modal">
                                <i class="fa fa-close" aria-hidden="true">&nbsp;Delete File</i>
                            </a>
                        </td>
                        {{/if}}
                    </tr>
                    {{/each}}
                </tbody>
                <tfoot>
                    <tr>
                        {{#if ../user}}
                        <th class="col-lg-2">Title</th>
                        <th class="col-lg-2">File</th>
                        <th class="col-lg-2">File Size</th>
                        <th class="col-lg-3">Last Modified</th>
                        <th class="col-lg-3 no-sort">Actions</th>
                        {{else}}
                        <th class="col-lg-3">Title</th>
                        <th class="col-lg-3">File</th>
                        <th class="col-lg-3">File Size</th>
                        <th class="col-lg-3">Last Modified</th>
                        {{/if}}
                    </tr>
                </tfoot>
            </table> <!-- /table -->
        </div>
        {{/each}}
        {{#if user}}
        <!-- deleteModal -->
        <div id="deleteModal" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <i class="fa fa-times" aria-hidden="true"></i>
                        </button>
                        <h4 class="modal-title">Delete File</h4>
                    </div>
                    <div class="modal-body">
                        <p class="file-name"></p>
                        <p>Are you sure? The file will be permanently deleted.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger">Delete</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="upload" class="tab-pane fade col-lg-12">
            <form action="/upload" method="post" accept-charset="UTF-8" role="form" enctype="multipart/form-data">
                <legend>File Upload</legend>
                <h4>Title</h4>
                <input id="filetitle" name="title" class="form-control" type="text" placeholder="File Title" required>
                <h4>Category</h4>
                <select name="category" class="form-control" required>
                    <option value="Latest Information">Latest Information</option>
                    <option value="Forms">Forms</option>
                    <option value="Policies">Policies</option>
                    <option value="Progress Scheme">Progress Scheme</option>
                    <option value="Others">Others</option>
                </select>
                <h4>File</h4>
                <div class="input-group">
                    <input id="filename" class="form-control" type="text" value="No File Selected." readonly>
                    <span class="input-group-btn">
                        <span class="btn btn-info btn-file">
                            <span>Browse...</span>
                            <input type="file" name="file" required>
                        </span>
                    </span>
                </div>
                <br>
                <button type="submit" class="btn btn-success">Upload</button>
                <button type="reset" class="btn btn-danger">Clear</button>
            </form>
        </div> <!-- /.col-lg-12 -->
        {{/if}}
    </div> <!-- /.col-lg-9 -->
</main> <!-- /.container -->