<main class="container">
    <div class="col-lg-3">
        <div class="page-header">
            <span class="h1">Categories</span>
        </div>
        <ul class="shortcuts">
            <li><a href="/resource">Latest Information</a></li>
            <li><a href="/resource/forms">Forms</a></li>
            <li><a href="/resource/policies">Policies</a></li>
            <li><a href="/resource/progress_scheme">Progress Scheme</a></li>
            <li><a href="/resource/others">Others</a></li>
        </ul>
    </div>
    <div class="col-lg-9">
        <div class="page-header">
            <span class="h1">{{header_title}} <small>{{header_subtitle}}</small></span>
        </div>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th class="col-lg-4">File Name</th>
                    <th class="col-lg-4">File Size</th>
                    <th class="col-lg-4">Last Modified</th>
                </tr>
            </thead>
            <tbody>
                {{#each filelist}}
                <tr>
                    <td>
                        <a class="fancybox" href="{{../path}}{{this.name}}" title="{{name}}" rel="media">
                            <i class="fa fa-{{fileType this.name}}"></i>
                            {{this.name}}
                        </a>
                    </td>
                    <td>{{this.size}}</td>
                    <td>{{this.time}}</td>
                </tr>
                {{/each}}
            </tbody>
            <tfoot>
                <tr>
                    <th class="col-lg-4">File Name</th>
                    <th class="col-lg-4">File Size</th>
                    <th class="col-lg-4">Last Modified</th>
                </tr>
            </tfoot>
        </table> <!-- /.table -->
    </div> <!-- /.col-lg-9 -->
</main> <!-- /.container -->