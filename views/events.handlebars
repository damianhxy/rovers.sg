<div class="col-md-6">
    <div class="page-header" id="calendar"></div>
    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Forms</h3>
        </div>
        {{#if user.admin}}
        <div class="panel-body">
            <form class="form-horizontal" action="/forms" method="post" accept-charset="UTF-8" autocomplete="off">
                <div class="form-group">
                    <span class="col-md-2 control-label">Name</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="name" required>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Short URL</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="url" required>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Embed</span>
                    <div class="col-md-10">
                        <input type="text" class="form-control" name="embed" placeholder="https://docs.google.com..." required>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <div class="col-md-10 col-md-offset-2">
                        <button type="submit" class="btn btn-success col-md-4">Add form</button>
                    </div>
                </div> <!-- /.form-group -->
            </form>
            {{#if forms}}
            <form class="form-horizontal" action="/forms?_method=DELETE" method="post" accept-charset="UTF-8" autocomplete="off">
                <div class="form-group">
                    <span class="col-md-2 control-label">Short URL</span>
                    <div class="col-md-10">
                        <select class="form-control" name="url">
                            {{#each forms}}
                            <option value="{{this.url}}">{{this.url}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <div class="col-md-10 col-md-offset-2">
                        <button type="submit" class="btn btn-danger col-md-4">Remove Form</button>
                    </div>
                </div>  <!-- /.form-group -->
            </form>
            {{/if}}
        </div>
        {{/if}}
        {{#if forms}}
        <table class="table table-striped table-bordered sortable" data-sortable>
            <thead>
                {{#if user.admin}}
                <tr>
                    <th class="col-md-3 col-xs-6">Name</th>
                    <th class="col-md-3 hidden-xs">Short URL</th>
                    <th class="col-md-3 hidden-xs">Embed</th>
                    <th class="col-md-3 col-xs-6" data-defaultsort="desc" data-firstsort="asc">Added</th>
                </tr>
                {{else}}
                <tr>
                    <th class="col-md-6">Name</th>
                    <th class="col-md-6" data-defaultsort="desc" data-firstsort="asc">Added</th>
                </tr>
                {{/if}}
            </thead>
            <tbody>
                {{#each forms}}
                <tr>
                    <td><a href="/forms/{{this.url}}">{{this.name}}</a></td>
                    {{#if ../user.admin}}
                    <td class="hidden-xs">{{this.url}}</td>
                    <td class="wrap hidden-xs"><a href={{this.embed}}>{{this.embed}}</a></td>
                    {{/if}}
                    <td data-value="{{this.time}}" data-livestamp="{{this.time}}"></td>
                </tr>
                {{/each}}
            </tbody>
        </table> <!-- /.table -->
        {{/if}}
    </div> <!-- /.panel -->
</div> <!-- /.col-md-6 -->
<div class="col-md-6">
    <div class="panel panel-default page-header">
        <div class="panel-heading">
            <span class="h3 panel-title">Media</span>
            <div class="btn-group pull-right">
                <button class="btn btn-xs btn-default carousel-prev"><i class="fa fa-arrow-circle-left"></i></button>
                <button class="btn btn-xs btn-default carousel-next"><i class="fa fa-arrow-circle-right"></i></button>
            </div>
        </div>
        <div class="panel-body">
            <a class="anchor" id="media"></a>
            <div class="slick">
                <div>
                    <a data-toggle="lightbox" href="/img/Blood Drive.jpg" data-title="Blood Drive">
                        <img alt="Blood Drive" class="constrain" title="Click to view larger image" src="/img/cropped/Blood Drive.jpg">
                    </a>
                    <h3>Blood Drive</h3>
                </div>
                <div>
                    <a data-toggle="lightbox" href="/img/Project Orion.jpg" data-title="Project Orion">
                        <img alt="Project Orion" class="constrain" title="Click to view larger image" src="/img/cropped/Project Orion.jpg">
                    </a>
                    <h3>Project Orion</h3>
                </div>
                <div>
                    <a data-toggle="lightbox" href="/img/Gunung Rinjani.jpg" data-title="Gunung Rinjani">
                        <img alt="Gunung Rinjani" class="constrain" title="Click to view larger image" src="/img/cropped/Gunung Rinjani.jpg">
                    </a>
                    <h3>Gunung Rinjani</h3>
                </div>
                <div>
                    <a data-toggle="lightbox" href="/img/World Scout Youth Forum.jpg" data-title="World Scout Youth Forum">
                        <img alt="World Scout Youth Forum" class="constrain" title="Click to enlarge image" src="/img/cropped/World Scout Youth Forum.jpg">
                    </a>
                    <h3>World Scout Youth Forum</h3>
                </div>
            </div> <!-- /.slick -->
        </div>
    </div> <!-- /.panel -->
</div>
