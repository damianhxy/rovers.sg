<div class="container">
    <div class="section text-center">
        <div class="page-header"><h2>Upcoming Events</h2></div>
        {{> eventCardList upcoming}}
        <div class="btn-group">
            {{#if user.admin}}
            <a href="/events/add" class="btn btn-success"><i class="fa fa-plus"></i> Create Event</a>
            {{/if}}
            <a href="/events/all" class="btn btn-primary"><i class="fa fa-history"></i> All Events</a>
        </div>
    </div>
    {{> eventDetailsList upcoming}}
</div>
