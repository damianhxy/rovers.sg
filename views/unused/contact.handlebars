<div class="banner-container" id="contactBanner"></div>
<div class="container">
    <div class="section text-center">
        <div class="page-header"><h2>Ask Us Anything</h2></div>
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <dl class="dl-horizontal">
                    <dt>Email us at</dt>
                    <dd><a href="mailto:hq@scout.org.sg">hq@scout.org.sg</a> (<abbr title="Singapore Scout Association">SSA</abbr>)</dd>
                    <dd><a href="mailto:nrc@rovers.sg">nrc@rovers.sg</a> (SG Rovers)</dd>
                    <dt>Message us on</dt>
                    <dd><a href="https://www.facebook.com/singaporeroverscouts/">Facebook Page</a></dd>
                </dl> <!-- /.dl-horizontal -->
            </div> <!-- /.col-md-6 -->
        </div>
    </div>
    <div class="section">
        <div class="page-header text-center">
            <h2>Feedback Form</h2>
            {{#if user.admin}}
            <div class="text-center">
                <a href="https://docs.google.com/spreadsheets/d/1rEVLHZyfdQz77PxrO7ey5_T6FXvRb_bNLcRtqsM-Y_k/edit" class="btn btn-sm btn-primary" target="_blank">
                    <i class="fa fa-commenting-o"></i> View Responses
                </a>
            </div>
            {{/if}}
        </div>
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <form id="contactForm" class="form-horizontal" accept-charset="UTF-8" autocomplete="off">
                    <div class="form-group">
                        <span class="col-md-2 control-label">Name</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input type="text" class="form-control" name="entry.1229150054" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <span class="col-md-2 control-label">Email</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input type="email" class="form-control" name="entry.394656747" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <span class="col-md-2 control-label">Message</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <textarea class="form-control" name="entry.1720486249" rows="3" required></textarea>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <div class="col-md-10 col-md-offset-2">
                            <button type="submit" class="btn btn-success"><i class="fa fa-envelope"></i> Send Feedback</button>
                        </div> <!-- /.col-md-10 -->
                    </div> <!-- /.form-group -->
                </form>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
    </div>
</div>
<script src="/js/custom/contact.js"></script>
