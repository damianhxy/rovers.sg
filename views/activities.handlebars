<div class="section text-center container">
    <div class="page-header"><h2>Category: {{title}}</h2></div>
    {{#if events}}
    <div class="overflow">
        {{#each events}}
        <div class="panel panel-info card">
            {{#if favourite.name}}
            <a data-toggle="lightbox" data-title="{{favourite.name}}" href="{{favourite.path}}" class="thumbnail">
                <img src="{{favourite.path}}" alt="{{favourite.name}}">
            </a>
            {{else}}
            <a data-toggle="lightbox" data-title="Placeholder" href="/img/EventPicture.png" class="thumbnail">
                <img src="/img/EventPicture.png" alt="Placeholder">
            </a>
            {{/if}}
            <div class="panel-body">
                <strong class="wrap">{{title}}</strong>
                <p>{{startPretty}}</p>
                <p>({{duration}})</p>
            </div>
            <div class="panel-footer">
                <a href="#{{this._id}}">View Information</a>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <h4>There are currently no events</h4>
    {{/if}}
</div>
{{#each events}}
<a class="anchor" id="{{_id}}"></a>
<div class="section text-center container">
    <div class="page-header">
        <a href="/events/{{_id}}"><h2>{{title}}</h2></a>
    </div>
    <div class="row">
        <div class="col-md-3">
            {{#if favourite.name}}
            <a data-toggle="lightbox" data-title="{{favourite.name}}" href="{{favourite.path}}" class="thumbnail">
                <img src="{{favourite.path}}" alt="{{favourite.name}}">
            </a>
            {{else}}
            <a data-toggle="lightbox" data-title="Placeholder" href="/img/EventPicture.png" class="thumbnail">
                <img src="/img/EventPicture.png" alt="Placeholder">
            </a>
            {{/if}}
        </div> <!-- /.col-md-3 -->
        <div class="col-md-9">
            <dl class="dl-horizontal">
                {{#if location}}
                <dt>Location</dt>
                <dd>{{location}}</dd>
                {{/if}}
                <dt>Start</dt>
                <dd>{{startPretty}}</dd>
                <dt>Duration</dt>
                <dd>{{duration}}</dd>
                {{#if details}}
                <dt>Additional Details</dt>
                <dd>{{details}}</dd>
                {{/if}}
                {{#if link}}
                <dt>Link</dt>
                <dd><a href="{{link}}">{{link}}</a></dd>
                {{/if}}
                {{#if category}}
                <dt>Categories</dt>
                <dd>
                {{#each category}}
                    <a href="/activities/{{this}}" class="label label-info">{{this}}</a>
                {{/each}}
                </dd>
                {{/if}}
                <dt>Last Modified</dt>
                <dd data-livestamp="{{time}}"></dd>
            </dl>
        </div> <!-- /.col-md-9 -->
    </div> <!-- /.row -->
</div>
{{/each}}
