<div class="col-md-12">
    <div class="page-header">
        <h2>Account Settings</h2>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-edit"></i> Password Change</h3>
        </div>
        <div class="panel-body">
            <form class="form-horizontal" action="/users/editPassword" method="post" accept-charset="UTF-8" autocomplete="off">
                <div class="form-group">
                    <span class="col-md-2 control-label">Current Password</span>
                    <div class="col-md-10">
                        <input name="currentPassword" class="form-control" type="password" required>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">New Password</span>
                    <div class="col-md-10">
                        <input name="newPass" class="form-control" type="password" required>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <span class="col-md-2 control-label">Repeat New Password</span>
                    <div class="col-md-10">
                        <input name="newPass2" class="form-control" type="password" required>
                    </div>
                </div> <!-- /.form-group -->
                <div class="form-group">
                    <div class="col-md-10 col-md-offset-2">
                        <button type="submit" class="btn btn-success">Update Password</button>
                    </div>
                </div> <!-- /.form-group -->
            </form>
        </div>
    </div> <!-- /.panel -->
    {{#if user.admin}}
    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-info-circle"></i> Server Information</h3>
        </div>
        <table class="table table-striped table-bordered sortable" data-sortable>
            <thead>
                <tr>
                    <th class="col-md-6" data-defaultsort="asc" data-firstsort="desc">Attribute</th>
                    <th class="col-md-6">Value</th>
                </tr>
            </thead>
            <tbody>
            {{#each info}}
                <tr>
                    <td>{{@key}}</td>
                    <td>{{this}}</td>
                </tr>
            {{/each}}
            </tbody>
        </table> <!-- /.table -->
    </div> <!-- /.panel -->
    {{/if}}
</div> <!-- /.col-md-12 -->
