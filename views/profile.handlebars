<div class="container">
    <div class="section">
        <div class="text-center page-header"><h2>Update Password</h2></div>
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <form class="form-horizontal" action="/users/editPassword" method="post" accept-charset="UTF-8" autocomplete="off">
                    <div class="form-group">
                        <span class="col-md-2 control-label">Current</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input name="currentPassword" class="form-control" type="password" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <span class="col-md-2 control-label">New</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input name="newPass" class="form-control" type="password" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <span class="col-md-2 control-label">Repeat</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input name="newPass2" class="form-control" type="password" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <div class="col-md-10 col-md-offset-2">
                            <button type="submit" class="btn btn-success"><i class="fa fa-certificate"></i> Update Password</button>
                        </div>
                    </div> <!-- /.form-group -->
                </form>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
    </div>
    {{#if user.admin}}
    <div class="section">
        <div class="page-header text-center"><h2>Link Shortener</h2></div>
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <form class="form-horizontal" action="/s" method="post" accept-charset="UTF-8" autocomplete="off">
                    <div class="form-group">
                        <span class="col-md-2 control-label">Name</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input type="text" class="form-control" name="name" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <span class="col-md-2 control-label">Original URL</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input type="text" class="form-control" name="orgurl" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <span class="col-md-2 control-label">Short URL</span>
                        <div class="col-md-10">
                            <div class="input-group">
                                <input type="text" class="form-control" name="newurl" required>
                                <div class="input-group-addon">*</div>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <div class="checkbox">
                            <div class="col-md-10 col-md-offset-2">
                                <label>
                                    <input type="checkbox" name="embed"> Embedded Link
                                </label>
                            </div>
                        </div>
                    </div> <!-- /.form-group -->
                    <div class="form-group">
                        <div class="col-md-10 col-md-offset-2">
                            <button type="submit" class="btn btn-success"><i class="fa fa-plus-circle"></i> Create Link</button>
                        </div>
                    </div> <!-- /.form-group -->
                </form>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
    </div>
    <div class="section">
        <div class="text-center page-header"><h2>Manage link(s)</h2></div>
        {{#if links}}
        <div class="row">
            <table class="table table-striped table-bordered sortable" data-sortable>
                <thead>
                    <tr>
                        <th class="col-md-2 hidden-xs">Name</th>
                        <th class="col-md-3 col-xs-4">Original URL</th>
                        <th class="col-md-2 hidden-xs">Short URL</th>
                        <th class="col-md-1 hidden-xs">Embed</th>
                        <th class="col-md-2 col-xs-4" data-defaultsort="desc" data-firstsort="asc">Added</th>
                        <th class="col-md-2 col-xs-4" data-defaultsort="disabled">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each links}}
                    <tr>
                        <td>{{name}}</td>
                        <td><a href="{{orgurl}}">{{orgurl}}</a></td>
                        <td class="hidden-xs">
                            <a href="/s/{{newurl}}">{{newurl}}</a>
                        </td>
                        <td class="hidden-xs">
                            {{#if embed}}
                            &checkmark;
                            {{else}}
                            &#x2717;
                            {{/if}}
                        </td>
                        <td data-value="{{time}}" data-livestamp="{{time}}"></td>
                        <td>
                            <button class="btn btn-danger btn-xs btn-delete" data-name="{{newurl}}" data-time="{{time}}" data-id="{{_id}}">
                                <i class="fa fa-times-circle"></i> Delete
                            </button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table> <!-- /.table -->
        </div> <!-- /.row -->
        {{else}}
        <h4 class="text-center">There are currently no links</h4>
        {{/if}}
    </div>
    <div class="section text-center">
        <div class="page-header"><h2>Server Information</h2></div>
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <dl class="dl-horizontal">
                    {{#each info}}
                    <dt>{{@key}}</dt>
                    <dd>{{this}}</dd>
                    {{/each}}
                </dl>
            </div> <!-- /.col-md-6 -->
        </div> <!-- /.row -->
    </div>
    {{/if}}
</div>
<script src="/lib/custom/profile.js"></script>
